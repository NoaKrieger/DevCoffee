{
  "name": "webdevoo/devcoffee-api",
  "description": "DevCoffee Tracker - API RESTful de suivi de consommation de cafeine (TP note)",
  "type": "project",
  "require": {
    "php": "^8.1",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public"
  },
  "config": {
    "sort-packages": true
  }
}
